+void
+dwindle(Monitor *m)
+{
+       unsigned int i, n = 0;
+       int nx, ny, nw, nh;
+       int horizontal;
+       int oe = enablegaps, ie = enablegaps;
+       Client *c;
+
+       /* count clients */
+       wl_list_for_each(c, &clients, link)
+               if (VISIBLEON(c, m) && !c->isfloating && !c->isfullscreen)
+                       n++;
+
+       if (n == 0)
+               return;
+
+       if (smartgaps == n)
+               oe = 0; // outer gaps disabled
+
+       nx = m->w.x + m->gappoh*oe;
+       ny = m->w.y + m->gappov*oe;
+       nw = m->w.width - 2 * m->gappoh*oe;
+       nh = m->w.height - 2 * m->gappov*oe;
+
+       horizontal = 1; // toggle split direction
+       i = 0;
+
+       wl_list_for_each(c, &clients, link) {
+               if (!VISIBLEON(c, m) || c->isfloating || c->isfullscreen)
+                       continue;
+
+               if (i == n - 1) {
+                       resize(c, (struct wlr_box){nx, ny, nw, nh}, 0);
+               } else if (horizontal) {
+                       int w = (nw - m->gappiv*ie) / 2;
+
+                       resize(c, (struct wlr_box){nx, ny, w, nh}, 0);
+                       nx += w + m->gappiv*ie;
+                       nw -= w + m->gappiv*ie;
+               } else {
+                       int h = (nh - m->gappih*ie) / 2;
+
+                       resize(c, (struct wlr_box){nx, ny, nw, h}, 0);
+                       ny += h + m->gappih*ie;
+                       nh -= h + m->gappih*ie;
+               }
+               horizontal = !horizontal;
+               i++;
+       }
+}
